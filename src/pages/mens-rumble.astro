---
import Layout from '../layouts/Layout.astro';
import EntrantList from '../components/EntrantList';
import RingStatus from '../components/RingStatus';
import AdminPanel from '../components/AdminPanel';
---

<Layout title="Men's Royal Rumble">
  <div class="space-y-6">
    <!-- Header -->
    <div class="text-center">
      <h1 class="text-3xl sm:text-5xl font-black mb-2 page-title">
        <span class="blue-chrome-text">MEN'S ROYAL RUMBLE</span>
      </h1>
      <p class="text-purple-300">30 Superstars compete for a WrestleMania title shot</p>

      <!-- Admin Toggle -->
      <button
        id="admin-toggle"
        class="hidden mt-3 px-4 py-2 bg-purple-900/50 hover:bg-purple-800/50 rounded-lg text-purple-300 text-sm font-medium transition-colors border border-purple-700/50"
      >
        Show Admin Panel
      </button>
    </div>

    <!-- Main Content Grid -->
    <div class="grid lg:grid-cols-3 gap-6">
      <!-- Left Column: Entrant List -->
      <div class="lg:col-span-2">
        <div class="vaporwave-card p-4">
          <h2 class="text-lg font-bold mb-4 flex items-center justify-center gap-2">
            <span class="w-3 h-3 bg-cyan-400 rounded-full animate-pulse shadow-lg shadow-cyan-500/50" />
            <span class="blue-chrome-text">ENTRANTS</span>
          </h2>
          <div id="entrant-list">
            <EntrantList client:load rumbleType="mens" />
          </div>
        </div>
      </div>

      <!-- Right Column: Ring Status + Admin -->
      <div class="space-y-6">
        <!-- Ring Status -->
        <div id="ring-status">
          <RingStatus client:load rumbleType="mens" />
        </div>

        <!-- Admin Panel (hidden by default) -->
        <div id="admin-panel" class="hidden">
          <AdminPanel client:load rumbleType="mens" />
        </div>

        <!-- User's Numbers -->
        <div class="vaporwave-card p-4">
          <h3 class="text-lg font-bold mb-3 text-center">
            <span class="gold-chrome-text">YOUR NUMBERS</span>
          </h3>
          <div id="user-numbers" class="text-purple-300 text-sm text-center">
            Select your name on the home page to see your numbers.
          </div>
        </div>

        <!-- Lucky Numbers Info -->
        <div class="vaporwave-card p-4">
          <h3 class="text-lg font-bold mb-3 text-center">
            <span class="gold-chrome-text">LUCKY NUMBERS</span>
          </h3>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-cyan-400 font-bold">#30</span>
              <span class="text-white">5 wins (most)</span>
            </div>
            <div class="flex justify-between">
              <span class="text-cyan-400 font-bold">#27</span>
              <span class="text-white">5 wins</span>
            </div>
            <div class="flex justify-between">
              <span class="text-cyan-400 font-bold">#28</span>
              <span class="text-white">4 wins</span>
            </div>
            <div class="flex justify-between">
              <span class="text-cyan-400 font-bold">#1</span>
              <span class="text-white">4 wins</span>
            </div>
          </div>
          <a href="/reference" class="block mt-3 text-xs text-cyan-400 hover:text-cyan-300 transition-colors">
            View all stats &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { initCurrentUser, $currentUser, getUserLotteryNumbers } from '../stores/matchStore';
  import { initAdmin, isAdmin } from '../stores/adminApi';

  // Initialize current user and admin mode from localStorage/URL
  initCurrentUser();
  initAdmin();

  if (isAdmin()) {
    const adminToggle = document.getElementById('admin-toggle');
    const adminPanel = document.getElementById('admin-panel');

    if (adminToggle && adminPanel) {
      adminToggle.classList.remove('hidden');

      adminToggle.addEventListener('click', () => {
        const isHidden = adminPanel.classList.contains('hidden');
        adminPanel.classList.toggle('hidden');
        adminToggle.textContent = isHidden ? 'Hide Admin Panel' : 'Show Admin Panel';
      });
    }
  }

  // Update user numbers display
  function updateUserNumbers() {
    const userNumbers = document.getElementById('user-numbers');
    if (!userNumbers) return;

    const currentUser = $currentUser.get();
    if (!currentUser) {
      userNumbers.innerHTML = `
        <p>Select your name on the <a href="/" class="text-blue-400 hover:underline">home page</a> to see your numbers.</p>
      `;
      return;
    }

    const numbers = getUserLotteryNumbers(currentUser.id, 'mens');
    if (numbers.length === 0) {
      userNumbers.innerHTML = `
        <p class="text-gray-400">No numbers assigned yet.</p>
        <a href="/lottery" class="text-blue-400 hover:underline text-xs">Go to lottery draw</a>
      `;
    } else {
      userNumbers.innerHTML = `
        <div class="flex justify-center gap-2">
          ${numbers.map(num => `
            <span class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold">
              ${num}
            </span>
          `).join('')}
        </div>
      `;
    }
  }

  // Subscribe to user changes
  $currentUser.subscribe(updateUserNumbers);
  updateUserNumbers();
</script>
