---
import Layout from '../layouts/Layout.astro';
import Leaderboard from '../components/Leaderboard.tsx';
import SyncIndicator from '../components/SyncIndicator.tsx';
---

<Layout title="Leaderboard">
  <div class="space-y-8">
    <!-- Header -->
    <div class="text-center">
      <h1 class="text-3xl sm:text-5xl font-black mb-2 page-title">
        <span class="gold-chrome-text">LEADERBOARD</span>
        <span class="neon-cyan">& AWARDS</span>
      </h1>
      <div class="flex items-center justify-center gap-3">
        <p class="text-purple-300">
          Track who's winning the watch party competition
        </p>
        <SyncIndicator client:load />
      </div>
    </div>

    <Leaderboard client:load />
  </div>
</Layout>

<script>
  import { initSync } from '../stores/syncStore';
  import { initCurrentUser } from '../stores/matchStore';

  initCurrentUser();
  initSync();
</script>
