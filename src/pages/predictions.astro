---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Predictions">
  <div class="space-y-8">
    <!-- Header -->
    <div class="text-center">
      <h1 class="text-3xl sm:text-5xl font-black mb-2 page-title">
        <span class="gold-chrome-text">PREDICTIONS</span>
        <span class="neon-cyan">& BETS</span>
      </h1>
      <p class="text-purple-300 max-w-lg mx-auto">
        Make predictions before and during the match. Right answers earn points!
      </p>
    </div>

    <!-- Current User -->
    <div id="current-user-display" class="text-center text-purple-300">
      Loading...
    </div>

    <!-- Prediction Categories -->
    <div class="grid md:grid-cols-2 gap-6">
      <!-- Men's Rumble Predictions -->
      <section class="vaporwave-card p-6 border-blue-800/50">
        <h2 class="text-xl font-bold mb-1 text-center">
          <span class="blue-chrome-text">MEN'S RUMBLE PREDICTIONS</span>
        </h2>
        <p class="text-purple-300 text-sm mb-4 text-center">Make your picks for the Men's Royal Rumble</p>

        <div class="space-y-4">
          <div class="p-4 bg-gradient-to-r from-blue-900/30 to-transparent rounded-lg border border-blue-800/30">
            <h4 class="text-cyan-400 font-bold mb-2">Who wins the Men's Rumble?</h4>
            <select id="mens-winner" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-cyan-800/50 focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400">
              <option value="">Select wrestler...</option>
            </select>
          </div>

          <div class="p-4 bg-gradient-to-r from-blue-900/30 to-transparent rounded-lg border border-blue-800/30">
            <h4 class="text-cyan-400 font-bold mb-2">Who gets Iron Man (longest time)?</h4>
            <select id="mens-ironman" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-cyan-800/50 focus:border-cyan-400">
              <option value="">Select wrestler...</option>
            </select>
          </div>

          <div class="p-4 bg-gradient-to-r from-blue-900/30 to-transparent rounded-lg border border-blue-800/30">
            <h4 class="text-cyan-400 font-bold mb-2">Who gets most eliminations?</h4>
            <select id="mens-elims" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-cyan-800/50 focus:border-cyan-400">
              <option value="">Select wrestler...</option>
            </select>
          </div>

          <div class="p-4 bg-gradient-to-r from-blue-900/30 to-transparent rounded-lg border border-blue-800/30">
            <h4 class="text-cyan-400 font-bold mb-2">First elimination?</h4>
            <select id="mens-first-elim" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-cyan-800/50 focus:border-cyan-400">
              <option value="">Select wrestler...</option>
            </select>
          </div>

          <div class="p-4 bg-gradient-to-r from-blue-900/30 to-transparent rounded-lg border border-blue-800/30">
            <h4 class="text-cyan-400 font-bold mb-2">Final two wrestlers?</h4>
            <div class="grid grid-cols-2 gap-2">
              <select id="mens-final-1" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-cyan-800/50 focus:border-cyan-400 text-sm">
                <option value="">First finalist...</option>
              </select>
              <select id="mens-final-2" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-cyan-800/50 focus:border-cyan-400 text-sm">
                <option value="">Second finalist...</option>
              </select>
            </div>
          </div>

          <div class="p-4 bg-gradient-to-r from-blue-900/30 to-transparent rounded-lg border border-blue-800/30">
            <h4 class="text-cyan-400 font-bold mb-2">Final four wrestlers?</h4>
            <div class="grid grid-cols-2 gap-2">
              <select id="mens-final4-1" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-cyan-800/50 focus:border-cyan-400 text-sm">
                <option value="">Wrestler 1...</option>
              </select>
              <select id="mens-final4-2" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-cyan-800/50 focus:border-cyan-400 text-sm">
                <option value="">Wrestler 2...</option>
              </select>
              <select id="mens-final4-3" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-cyan-800/50 focus:border-cyan-400 text-sm">
                <option value="">Wrestler 3...</option>
              </select>
              <select id="mens-final4-4" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-cyan-800/50 focus:border-cyan-400 text-sm">
                <option value="">Wrestler 4...</option>
              </select>
            </div>
          </div>
        </div>
      </section>

      <!-- Women's Rumble Predictions -->
      <section class="vaporwave-card p-6 border-pink-800/50">
        <h2 class="text-xl font-bold mb-1 text-center">
          <span class="neon-pink">WOMEN'S RUMBLE PREDICTIONS</span>
        </h2>
        <p class="text-purple-300 text-sm mb-4 text-center">Make your picks for the Women's Royal Rumble</p>

        <div class="space-y-4">
          <div class="p-4 bg-gradient-to-r from-pink-900/30 to-transparent rounded-lg border border-pink-800/30">
            <h4 class="text-pink-400 font-bold mb-2">Who wins the Women's Rumble?</h4>
            <select id="womens-winner" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-pink-800/50 focus:border-pink-400 focus:ring-1 focus:ring-pink-400">
              <option value="">Select wrestler...</option>
            </select>
          </div>

          <div class="p-4 bg-gradient-to-r from-pink-900/30 to-transparent rounded-lg border border-pink-800/30">
            <h4 class="text-pink-400 font-bold mb-2">Who gets Iron Woman (longest time)?</h4>
            <select id="womens-ironwoman" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-pink-800/50 focus:border-pink-400">
              <option value="">Select wrestler...</option>
            </select>
          </div>

          <div class="p-4 bg-gradient-to-r from-pink-900/30 to-transparent rounded-lg border border-pink-800/30">
            <h4 class="text-pink-400 font-bold mb-2">Who gets most eliminations?</h4>
            <select id="womens-elims" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-pink-800/50 focus:border-pink-400">
              <option value="">Select wrestler...</option>
            </select>
          </div>

          <div class="p-4 bg-gradient-to-r from-pink-900/30 to-transparent rounded-lg border border-pink-800/30">
            <h4 class="text-pink-400 font-bold mb-2">First elimination?</h4>
            <select id="womens-first-elim" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-pink-800/50 focus:border-pink-400">
              <option value="">Select wrestler...</option>
            </select>
          </div>

          <div class="p-4 bg-gradient-to-r from-pink-900/30 to-transparent rounded-lg border border-pink-800/30">
            <h4 class="text-pink-400 font-bold mb-2">Final two wrestlers?</h4>
            <div class="grid grid-cols-2 gap-2">
              <select id="womens-final-1" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-pink-800/50 focus:border-pink-400 text-sm">
                <option value="">First finalist...</option>
              </select>
              <select id="womens-final-2" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-pink-800/50 focus:border-pink-400 text-sm">
                <option value="">Second finalist...</option>
              </select>
            </div>
          </div>

          <div class="p-4 bg-gradient-to-r from-pink-900/30 to-transparent rounded-lg border border-pink-800/30">
            <h4 class="text-pink-400 font-bold mb-2">Final four wrestlers?</h4>
            <div class="grid grid-cols-2 gap-2">
              <select id="womens-final4-1" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-pink-800/50 focus:border-pink-400 text-sm">
                <option value="">Wrestler 1...</option>
              </select>
              <select id="womens-final4-2" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-pink-800/50 focus:border-pink-400 text-sm">
                <option value="">Wrestler 2...</option>
              </select>
              <select id="womens-final4-3" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-pink-800/50 focus:border-pink-400 text-sm">
                <option value="">Wrestler 3...</option>
              </select>
              <select id="womens-final4-4" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-pink-800/50 focus:border-pink-400 text-sm">
                <option value="">Wrestler 4...</option>
              </select>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Surprise Entrants & Special Predictions -->
    <div class="grid md:grid-cols-2 gap-6">
      <!-- Surprise Entrants -->
      <section class="vaporwave-card p-6">
        <h2 class="text-xl font-bold mb-1 text-center">
          <span class="gold-chrome-text">SURPRISE ENTRANT PREDICTIONS</span>
        </h2>
        <p class="text-purple-300 text-sm mb-4 text-center">Which non-WWE wrestlers might show up?</p>

        <div class="space-y-4">
          <div class="p-4 bg-gradient-to-r from-yellow-900/20 to-transparent rounded-lg border border-yellow-800/30">
            <h4 class="text-yellow-400 font-bold mb-2">AEW surprise entrant?</h4>
            <p class="text-purple-300 text-xs mb-2">Will anyone from AEW make a shock appearance?</p>
            <select id="aew-surprise" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-yellow-800/50 focus:border-yellow-400">
              <option value="">Select wrestler or "None"...</option>
              <option value="none">No AEW surprise</option>
            </select>
          </div>

          <div class="p-4 bg-gradient-to-r from-yellow-900/20 to-transparent rounded-lg border border-yellow-800/30">
            <h4 class="text-yellow-400 font-bold mb-2">TNA surprise entrant?</h4>
            <p class="text-purple-300 text-xs mb-2">Will anyone from TNA make an appearance?</p>
            <select id="tna-surprise" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-yellow-800/50 focus:border-yellow-400">
              <option value="">Select wrestler or "None"...</option>
              <option value="none">No TNA surprise</option>
            </select>
          </div>

          <div class="p-4 bg-gradient-to-r from-yellow-900/20 to-transparent rounded-lg border border-yellow-800/30">
            <h4 class="text-yellow-400 font-bold mb-2">Legend/HOF return?</h4>
            <p class="text-purple-300 text-xs mb-2">Which legend will make a surprise return?</p>
            <select id="legend-return" class="prediction-select w-full p-2 bg-gray-800/80 rounded text-white border border-yellow-800/50 focus:border-yellow-400">
              <option value="">Select legend or "None"...</option>
              <option value="none">No legend return</option>
            </select>
          </div>
        </div>
      </section>

      <!-- Special Predictions -->
      <section class="vaporwave-card p-6">
        <h2 class="text-xl font-bold mb-1 text-center">
          <span class="gold-chrome-text">SPECIAL PREDICTIONS</span>
        </h2>
        <p class="text-purple-300 text-sm mb-4 text-center">Bold predictions and fun bets</p>

        <div class="space-y-4">
          <div class="p-4 bg-gradient-to-r from-purple-900/20 to-transparent rounded-lg border border-purple-800/30">
            <h4 class="text-purple-400 font-bold mb-2">Will Entry #27 win either Rumble?</h4>
            <p class="text-purple-300 text-xs mb-2">#27 has historically been the "lucky number"</p>
            <div class="flex gap-2">
              <button class="prediction-btn flex-1 py-2 rounded bg-gray-800/80 text-gray-300 hover:bg-green-600 hover:text-white border border-green-800/30 transition-all" data-prediction="lucky27" data-value="yes">Yes</button>
              <button class="prediction-btn flex-1 py-2 rounded bg-gray-800/80 text-gray-300 hover:bg-red-600 hover:text-white border border-red-800/30 transition-all" data-prediction="lucky27" data-value="no">No</button>
            </div>
          </div>

          <div class="p-4 bg-gradient-to-r from-purple-900/20 to-transparent rounded-lg border border-purple-800/30">
            <h4 class="text-purple-400 font-bold mb-2">Will a champion enter the Rumble?</h4>
            <div class="flex gap-2">
              <button class="prediction-btn flex-1 py-2 rounded bg-gray-800/80 text-gray-300 hover:bg-green-600 hover:text-white border border-green-800/30 transition-all" data-prediction="champion-enters" data-value="yes">Yes</button>
              <button class="prediction-btn flex-1 py-2 rounded bg-gray-800/80 text-gray-300 hover:bg-red-600 hover:text-white border border-red-800/30 transition-all" data-prediction="champion-enters" data-value="no">No</button>
            </div>
          </div>

          <div class="p-4 bg-gradient-to-r from-purple-900/20 to-transparent rounded-lg border border-purple-800/30">
            <h4 class="text-purple-400 font-bold mb-2">Will there be a celebrity entrant?</h4>
            <div class="flex gap-2">
              <button class="prediction-btn flex-1 py-2 rounded bg-gray-800/80 text-gray-300 hover:bg-green-600 hover:text-white border border-green-800/30 transition-all" data-prediction="celebrity" data-value="yes">Yes</button>
              <button class="prediction-btn flex-1 py-2 rounded bg-gray-800/80 text-gray-300 hover:bg-red-600 hover:text-white border border-red-800/30 transition-all" data-prediction="celebrity" data-value="no">No</button>
            </div>
          </div>

          <div class="p-4 bg-gradient-to-r from-purple-900/20 to-transparent rounded-lg border border-purple-800/30">
            <h4 class="text-purple-400 font-bold mb-2">Will CM Punk and Seth Rollins be in the ring together?</h4>
            <div class="flex gap-2">
              <button class="prediction-btn flex-1 py-2 rounded bg-gray-800/80 text-gray-300 hover:bg-green-600 hover:text-white border border-green-800/30 transition-all" data-prediction="punk-seth" data-value="yes">Yes</button>
              <button class="prediction-btn flex-1 py-2 rounded bg-gray-800/80 text-gray-300 hover:bg-red-600 hover:text-white border border-red-800/30 transition-all" data-prediction="punk-seth" data-value="no">No</button>
            </div>
          </div>

          <div class="p-4 bg-gradient-to-r from-purple-900/20 to-transparent rounded-lg border border-purple-800/30">
            <h4 class="text-purple-400 font-bold mb-2">Winning entry number range?</h4>
            <p class="text-purple-300 text-xs mb-2">What range will the winner enter from?</p>
            <div class="grid grid-cols-3 gap-2">
              <button class="prediction-btn py-2 rounded bg-gray-800/80 text-gray-300 hover:bg-purple-600 hover:text-white border border-purple-800/30 text-sm transition-all" data-prediction="entry-range" data-value="1-10">#1-10</button>
              <button class="prediction-btn py-2 rounded bg-gray-800/80 text-gray-300 hover:bg-purple-600 hover:text-white border border-purple-800/30 text-sm transition-all" data-prediction="entry-range" data-value="11-20">#11-20</button>
              <button class="prediction-btn py-2 rounded bg-gray-800/80 text-gray-300 hover:bg-purple-600 hover:text-white border border-purple-800/30 text-sm transition-all" data-prediction="entry-range" data-value="21-30">#21-30</button>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- During-Match Section -->
    <div>
      <!-- During-Match Predictions -->
      <section class="vaporwave-card p-6">
        <h2 class="text-xl font-bold mb-1 text-center">
          <span class="gold-chrome-text">DRINKING GAME / LIVE BETS</span>
        </h2>
        <p class="text-purple-300 text-sm mb-4 text-center">Call these during the match for fun!</p>

        <div class="grid sm:grid-cols-2 gap-3">
          <button class="trope-btn w-full p-3 bg-gradient-to-r from-gray-800/80 to-transparent rounded-lg text-left hover:from-purple-900/50 transition-all flex items-center gap-3 border border-purple-800/30 hover:border-purple-500/50 group">
            <span class="text-2xl">🦶</span>
            <div>
              <div class="text-white font-bold group-hover:text-cyan-400 transition-colors">Kofi Save</div>
              <div class="text-purple-300 text-xs">Someone saves themselves from elimination creatively</div>
            </div>
          </button>
          <button class="trope-btn w-full p-3 bg-gradient-to-r from-gray-800/80 to-transparent rounded-lg text-left hover:from-purple-900/50 transition-all flex items-center gap-3 border border-purple-800/30 hover:border-purple-500/50 group">
            <span class="text-2xl">👴</span>
            <div>
              <div class="text-white font-bold group-hover:text-cyan-400 transition-colors">Legend Surprise</div>
              <div class="text-purple-300 text-xs">A Hall of Famer or legend makes a surprise return</div>
            </div>
          </button>
          <button class="trope-btn w-full p-3 bg-gradient-to-r from-gray-800/80 to-transparent rounded-lg text-left hover:from-purple-900/50 transition-all flex items-center gap-3 border border-purple-800/30 hover:border-purple-500/50 group">
            <span class="text-2xl">👹</span>
            <div>
              <div class="text-white font-bold group-hover:text-cyan-400 transition-colors">Monster Entrance</div>
              <div class="text-purple-300 text-xs">Everyone stops fighting when a big wrestler enters</div>
            </div>
          </button>
          <button class="trope-btn w-full p-3 bg-gradient-to-r from-gray-800/80 to-transparent rounded-lg text-left hover:from-purple-900/50 transition-all flex items-center gap-3 border border-purple-800/30 hover:border-purple-500/50 group">
            <span class="text-2xl">👀</span>
            <div>
              <div class="text-white font-bold group-hover:text-cyan-400 transition-colors">The Staredown</div>
              <div class="text-purple-300 text-xs">Two wrestlers have a dramatic face-off</div>
            </div>
          </button>
          <button class="trope-btn w-full p-3 bg-gradient-to-r from-gray-800/80 to-transparent rounded-lg text-left hover:from-purple-900/50 transition-all flex items-center gap-3 border border-purple-800/30 hover:border-purple-500/50 group">
            <span class="text-2xl">😤</span>
            <div>
              <div class="text-white font-bold group-hover:text-cyan-400 transition-colors">Sore Loser</div>
              <div class="text-purple-300 text-xs">Eliminated wrestler returns to attack someone</div>
            </div>
          </button>
          <button class="trope-btn w-full p-3 bg-gradient-to-r from-gray-800/80 to-transparent rounded-lg text-left hover:from-purple-900/50 transition-all flex items-center gap-3 border border-purple-800/30 hover:border-purple-500/50 group">
            <span class="text-2xl">🤝</span>
            <div>
              <div class="text-white font-bold group-hover:text-cyan-400 transition-colors">Enemy Mine</div>
              <div class="text-purple-300 text-xs">Rivals team up to eliminate a bigger threat</div>
            </div>
          </button>
          <button class="trope-btn w-full p-3 bg-gradient-to-r from-gray-800/80 to-transparent rounded-lg text-left hover:from-purple-900/50 transition-all flex items-center gap-3 border border-purple-800/30 hover:border-purple-500/50 group">
            <span class="text-2xl">⚡</span>
            <div>
              <div class="text-white font-bold group-hover:text-cyan-400 transition-colors">Quick Exit</div>
              <div class="text-purple-300 text-xs">Someone eliminated in under 10 seconds</div>
            </div>
          </button>
          <button class="trope-btn w-full p-3 bg-gradient-to-r from-gray-800/80 to-transparent rounded-lg text-left hover:from-purple-900/50 transition-all flex items-center gap-3 border border-purple-800/30 hover:border-purple-500/50 group">
            <span class="text-2xl">🏆</span>
            <div>
              <div class="text-white font-bold group-hover:text-cyan-400 transition-colors">Champion Enters</div>
              <div class="text-purple-300 text-xs">A current champion participates in the Rumble</div>
            </div>
          </button>
        </div>

        <div class="mt-4 p-3 bg-gradient-to-r from-yellow-900/30 to-orange-900/20 border border-yellow-600/50 rounded-lg">
          <p class="text-yellow-400 text-sm">
            <strong class="text-yellow-300">Drinking Rules:</strong> Take a drink every time one of these happens!
            Or assign points for being the first to call it.
          </p>
        </div>
      </section>
    </div>

  </div>

  <!-- Floating Betting Slip Toggle -->
  <button
    id="betting-slip-toggle"
    class="fixed bottom-20 sm:bottom-6 right-4 z-40 w-14 h-14 rounded-full bg-gradient-to-br from-yellow-500 via-pink-500 to-purple-600 text-white shadow-lg shadow-purple-500/40 flex items-center justify-center text-2xl transition-all hover:scale-110 hover:shadow-xl hover:shadow-pink-500/40 border-2 border-yellow-400/50"
    aria-label="View betting slip"
  >
    <span id="slip-icon">🎰</span>
  </button>

  <!-- Betting Slip Badge -->
  <span id="slip-badge" class="fixed bottom-[5.5rem] sm:bottom-[3.5rem] right-3 z-50 hidden w-6 h-6 rounded-full bg-cyan-400 text-gray-900 text-xs font-black flex items-center justify-center shadow-lg shadow-cyan-400/50 pointer-events-none">0</span>

  <!-- Betting Slip Drawer -->
  <div id="betting-slip-drawer" class="fixed inset-0 z-50 pointer-events-none">
    <!-- Backdrop -->
    <div id="slip-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"></div>

    <!-- Slip Panel -->
    <div id="slip-panel" class="absolute bottom-0 left-0 right-0 sm:right-4 sm:left-auto sm:bottom-4 sm:w-96 max-h-[85vh] translate-y-full transition-transform duration-300 ease-out pointer-events-auto">
      <div class="betting-slip-card rounded-t-2xl sm:rounded-2xl overflow-hidden flex flex-col max-h-[85vh]">
        <!-- Slip Header -->
        <div class="betting-slip-header px-5 py-4 flex items-center justify-between flex-shrink-0">
          <div>
            <h2 class="text-lg font-black tracking-wider uppercase betting-slip-title">Betting Slip</h2>
            <p class="text-xs text-purple-300/80 font-medium">Royal Rumble 2026</p>
          </div>
          <button id="slip-close" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors text-sm">
            ✕
          </button>
        </div>

        <!-- Torn edge effect -->
        <div class="betting-slip-tear flex-shrink-0"></div>

        <!-- Slip Body -->
        <div id="predictions-summary" class="betting-slip-body px-5 py-4 overflow-y-auto flex-1">
          <p class="text-purple-400 text-sm text-center py-8">No predictions made yet.<br/>Select options above!</p>
        </div>

        <!-- Slip Footer -->
        <div class="betting-slip-tear-bottom flex-shrink-0"></div>
        <div class="betting-slip-footer px-5 py-3 flex-shrink-0">
          <div class="flex items-center justify-between text-xs">
            <span class="text-purple-400 font-mono">TICKET #RR2026</span>
            <span id="slip-count" class="text-cyan-400 font-bold">0 picks</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .prediction-btn.selected {
    box-shadow: 0 0 0 2px #a855f7;
  }

  /* Betting Slip Styles */
  .betting-slip-card {
    background: linear-gradient(180deg, #1a0a2e 0%, #0d0d1a 50%, #1a0a2e 100%);
    border: 2px solid rgba(191, 0, 255, 0.4);
    box-shadow:
      0 0 30px rgba(191, 0, 255, 0.3),
      0 0 60px rgba(0, 255, 255, 0.1),
      inset 0 0 30px rgba(191, 0, 255, 0.05);
  }

  .betting-slip-header {
    background: linear-gradient(135deg, rgba(191, 0, 255, 0.2) 0%, rgba(0, 255, 255, 0.1) 100%);
    border-bottom: 1px solid rgba(191, 0, 255, 0.3);
  }

  .betting-slip-title {
    background: linear-gradient(90deg, #ffd700, #ff69b4, #00ffff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: none;
  }

  .betting-slip-tear {
    height: 8px;
    background-image: radial-gradient(circle at 8px 0, transparent 8px, #0d0d1a 8px);
    background-size: 16px 8px;
    background-position: -8px 0;
    opacity: 0.8;
  }

  .betting-slip-tear-bottom {
    height: 8px;
    background-image: radial-gradient(circle at 8px 8px, transparent 8px, #0d0d1a 8px);
    background-size: 16px 8px;
    background-position: -8px 0;
    opacity: 0.8;
  }

  .betting-slip-body {
    background: rgba(13, 13, 26, 0.95);
  }

  .betting-slip-footer {
    background: linear-gradient(135deg, rgba(191, 0, 255, 0.1) 0%, rgba(0, 255, 255, 0.05) 100%);
    border-top: 1px dashed rgba(191, 0, 255, 0.3);
  }

  .slip-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.375rem 0;
    border-bottom: 1px dotted rgba(128, 90, 213, 0.2);
  }

  .slip-row:last-child {
    border-bottom: none;
  }

  .slip-label {
    color: #c084fc;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
    max-width: 45%;
  }

  .slip-value {
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    text-align: right;
    max-width: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .slip-section-header {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.5rem 0 0.25rem;
    margin-top: 0.5rem;
    border-top: 1px solid rgba(191, 0, 255, 0.2);
  }

  .slip-section-header:first-child {
    margin-top: 0;
    border-top: none;
    padding-top: 0;
  }

  #betting-slip-drawer.open {
    pointer-events: auto;
  }

  #betting-slip-drawer.open #slip-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  #betting-slip-drawer.open #slip-panel {
    transform: translateY(0);
  }

  #slip-badge.has-picks {
    display: flex;
  }
</style>

<script>
  import { initCurrentUser, $currentUser, $wrestlers } from '../stores/matchStore';

  // Initialize current user
  initCurrentUser();

  // Display current user
  function updateUserDisplay() {
    const display = document.getElementById('current-user-display');
    if (!display) return;

    const user = $currentUser.get();
    if (user) {
      display.innerHTML = `
        <span class="text-white font-medium">Making predictions as: ${user.name}</span>
        <a href="/" class="text-purple-400 hover:underline text-sm ml-2">(change)</a>
      `;
    } else {
      display.innerHTML = `
        <span class="text-yellow-400">Please <a href="/" class="underline">select your name</a> first</span>
      `;
    }
  }

  $currentUser.subscribe(updateUserDisplay);
  updateUserDisplay();

  // Populate wrestler selects
  const wrestlers = $wrestlers.get();
  const maleWrestlers = wrestlers.filter(w => w.gender === 'male').sort((a, b) => a.name.localeCompare(b.name));
  const femaleWrestlers = wrestlers.filter(w => w.gender === 'female').sort((a, b) => a.name.localeCompare(b.name));
  const aewWrestlers = wrestlers.filter(w => w.promotion === 'AEW').sort((a, b) => a.name.localeCompare(b.name));
  const tnaWrestlers = wrestlers.filter(w => w.promotion === 'TNA').sort((a, b) => a.name.localeCompare(b.name));
  const legends = wrestlers.filter(w => w.isLegend || w.isHallOfFamer).sort((a, b) => a.name.localeCompare(b.name));

  // Helper to add options to a select
  function populateSelect(selectId: string, wrestlerList: typeof wrestlers, showBadges = true) {
    const select = document.getElementById(selectId) as HTMLSelectElement;
    if (!select) return;

    wrestlerList.forEach(w => {
      const option = document.createElement('option');
      option.value = w.id;
      let label = w.name;
      if (showBadges) {
        if (w.isCurrentChampion) label += ' (Champion)';
        if (w.isFormerRumbleWinner) label += ' (RR Winner)';
        if (w.isHallOfFamer) label += ' (HOF)';
      }
      option.textContent = label;
      select.appendChild(option);
    });
  }

  // Men's Rumble selects
  ['mens-winner', 'mens-ironman', 'mens-elims', 'mens-first-elim', 'mens-final-1', 'mens-final-2', 'mens-final4-1', 'mens-final4-2', 'mens-final4-3', 'mens-final4-4'].forEach(id => {
    populateSelect(id, maleWrestlers);
  });

  // Women's Rumble selects
  ['womens-winner', 'womens-ironwoman', 'womens-elims', 'womens-first-elim', 'womens-final-1', 'womens-final-2', 'womens-final4-1', 'womens-final4-2', 'womens-final4-3', 'womens-final4-4'].forEach(id => {
    populateSelect(id, femaleWrestlers);
  });

  // Surprise entrant selects
  populateSelect('aew-surprise', aewWrestlers);
  populateSelect('tna-surprise', tnaWrestlers);
  populateSelect('legend-return', legends);

  // Handle prediction button clicks
  document.querySelectorAll('.prediction-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const prediction = (btn as HTMLElement).dataset.prediction;
      const value = (btn as HTMLElement).dataset.value;

      // Remove selected from siblings
      document.querySelectorAll(`[data-prediction="${prediction}"]`).forEach(b => {
        b.classList.remove('selected', 'bg-green-600', 'bg-red-600', 'bg-purple-600', 'text-white');
        b.classList.add('bg-gray-700', 'text-gray-300');
      });

      // Add selected to this one
      const colorClass = value === 'yes' ? 'bg-green-600' : value === 'no' ? 'bg-red-600' : 'bg-purple-600';
      btn.classList.add('selected', colorClass, 'text-white');
      btn.classList.remove('bg-gray-700', 'text-gray-300');

      savePredictions();
      updatePredictionsSummary();
    });
  });

  // Save predictions to localStorage
  function savePredictions() {
    const user = $currentUser.get();
    if (!user) return;

    const predictions: Record<string, string> = {};

    // Save all select values
    document.querySelectorAll('.prediction-select').forEach(select => {
      const el = select as HTMLSelectElement;
      if (el.value) {
        predictions[el.id] = el.value;
      }
    });

    // Save all button predictions
    document.querySelectorAll('.prediction-btn.selected').forEach(btn => {
      const el = btn as HTMLElement;
      if (el.dataset.prediction && el.dataset.value) {
        predictions[el.dataset.prediction] = el.dataset.value;
      }
    });

    localStorage.setItem(`predictions-${user.id}`, JSON.stringify(predictions));
  }

  // Load predictions from localStorage
  function loadPredictions() {
    const user = $currentUser.get();
    if (!user) return;

    // Reset all selects
    document.querySelectorAll('.prediction-select').forEach(select => {
      (select as HTMLSelectElement).value = '';
    });

    // Reset all buttons
    document.querySelectorAll('.prediction-btn.selected').forEach(btn => {
      btn.classList.remove('selected', 'bg-green-600', 'bg-red-600', 'bg-purple-600', 'text-white');
      btn.classList.add('bg-gray-700', 'text-gray-300');
    });

    const saved = localStorage.getItem(`predictions-${user.id}`);
    if (!saved) {
      updatePredictionsSummary();
      return;
    }

    const predictions = JSON.parse(saved);

    // Restore select values
    Object.entries(predictions).forEach(([key, value]) => {
      const select = document.getElementById(key) as HTMLSelectElement;
      if (select) {
        select.value = value as string;
      } else {
        // It's a button prediction
        const btn = document.querySelector(`[data-prediction="${key}"][data-value="${value}"]`) as HTMLElement;
        if (btn) {
          const colorClass = value === 'yes' ? 'bg-green-600' : value === 'no' ? 'bg-red-600' : 'bg-purple-600';
          btn.classList.add('selected', colorClass, 'text-white');
          btn.classList.remove('bg-gray-700', 'text-gray-300');
        }
      }
    });

    updatePredictionsSummary();
  }

  // Helper to get wrestler name
  const getName = (id: string) => wrestlers.find(w => w.id === id)?.name || id;

  // Helper to get a select value
  const getSelect = (id: string) => (document.getElementById(id) as HTMLSelectElement)?.value || '';

  // Update predictions summary in the betting slip
  function updatePredictionsSummary() {
    const summary = document.getElementById('predictions-summary');
    const badge = document.getElementById('slip-badge');
    const slipCount = document.getElementById('slip-count');
    if (!summary) return;

    type SlipEntry = { label: string; value: string };
    const sections: { title: string; color: string; entries: SlipEntry[] }[] = [];

    // --- Men's Rumble ---
    const mensEntries: SlipEntry[] = [];
    const mw = getSelect('mens-winner');
    if (mw) mensEntries.push({ label: 'Winner', value: getName(mw) });
    const mi = getSelect('mens-ironman');
    if (mi) mensEntries.push({ label: 'Iron Man', value: getName(mi) });
    const me = getSelect('mens-elims');
    if (me) mensEntries.push({ label: 'Most Eliminations', value: getName(me) });
    const mfe = getSelect('mens-first-elim');
    if (mfe) mensEntries.push({ label: 'First Eliminated', value: getName(mfe) });
    const mf1 = getSelect('mens-final-1');
    const mf2 = getSelect('mens-final-2');
    if (mf1 || mf2) {
      const names = [mf1 ? getName(mf1) : '?', mf2 ? getName(mf2) : '?'].join(' & ');
      mensEntries.push({ label: 'Final Two', value: names });
    }
    const mf41 = getSelect('mens-final4-1');
    const mf42 = getSelect('mens-final4-2');
    const mf43 = getSelect('mens-final4-3');
    const mf44 = getSelect('mens-final4-4');
    const mf4vals = [mf41, mf42, mf43, mf44].filter(Boolean);
    if (mf4vals.length > 0) {
      mensEntries.push({ label: 'Final Four', value: mf4vals.map(v => getName(v)).join(', ') });
    }
    if (mensEntries.length > 0) {
      sections.push({ title: "Men's Rumble", color: 'text-cyan-400', entries: mensEntries });
    }

    // --- Women's Rumble ---
    const womensEntries: SlipEntry[] = [];
    const ww = getSelect('womens-winner');
    if (ww) womensEntries.push({ label: 'Winner', value: getName(ww) });
    const wi = getSelect('womens-ironwoman');
    if (wi) womensEntries.push({ label: 'Iron Woman', value: getName(wi) });
    const we = getSelect('womens-elims');
    if (we) womensEntries.push({ label: 'Most Eliminations', value: getName(we) });
    const wfe = getSelect('womens-first-elim');
    if (wfe) womensEntries.push({ label: 'First Eliminated', value: getName(wfe) });
    const wf1 = getSelect('womens-final-1');
    const wf2 = getSelect('womens-final-2');
    if (wf1 || wf2) {
      const names = [wf1 ? getName(wf1) : '?', wf2 ? getName(wf2) : '?'].join(' & ');
      womensEntries.push({ label: 'Final Two', value: names });
    }
    const wf41 = getSelect('womens-final4-1');
    const wf42 = getSelect('womens-final4-2');
    const wf43 = getSelect('womens-final4-3');
    const wf44 = getSelect('womens-final4-4');
    const wf4vals = [wf41, wf42, wf43, wf44].filter(Boolean);
    if (wf4vals.length > 0) {
      womensEntries.push({ label: 'Final Four', value: wf4vals.map(v => getName(v)).join(', ') });
    }
    if (womensEntries.length > 0) {
      sections.push({ title: "Women's Rumble", color: 'text-pink-400', entries: womensEntries });
    }

    // --- Surprise Entrants ---
    const surpriseEntries: SlipEntry[] = [];
    const aew = getSelect('aew-surprise');
    if (aew) surpriseEntries.push({ label: 'AEW Surprise', value: aew === 'none' ? 'None' : getName(aew) });
    const tna = getSelect('tna-surprise');
    if (tna) surpriseEntries.push({ label: 'TNA Surprise', value: tna === 'none' ? 'None' : getName(tna) });
    const legend = getSelect('legend-return');
    if (legend) surpriseEntries.push({ label: 'Legend Return', value: legend === 'none' ? 'None' : getName(legend) });
    if (surpriseEntries.length > 0) {
      sections.push({ title: 'Surprise Entrants', color: 'text-yellow-400', entries: surpriseEntries });
    }

    // --- Special Predictions ---
    const specialEntries: SlipEntry[] = [];
    const lucky27 = document.querySelector('[data-prediction="lucky27"].selected') as HTMLElement;
    if (lucky27) specialEntries.push({ label: '#27 Wins?', value: lucky27.dataset.value === 'yes' ? 'Yes' : 'No' });
    const championEnters = document.querySelector('[data-prediction="champion-enters"].selected') as HTMLElement;
    if (championEnters) specialEntries.push({ label: 'Champion Enters?', value: championEnters.dataset.value === 'yes' ? 'Yes' : 'No' });
    const celebrity = document.querySelector('[data-prediction="celebrity"].selected') as HTMLElement;
    if (celebrity) specialEntries.push({ label: 'Celebrity Entrant?', value: celebrity.dataset.value === 'yes' ? 'Yes' : 'No' });
    const punkSeth = document.querySelector('[data-prediction="punk-seth"].selected') as HTMLElement;
    if (punkSeth) specialEntries.push({ label: 'Punk & Seth Together?', value: punkSeth.dataset.value === 'yes' ? 'Yes' : 'No' });
    const entryRange = document.querySelector('[data-prediction="entry-range"].selected') as HTMLElement;
    if (entryRange) specialEntries.push({ label: 'Winner Entry Range', value: `#${entryRange.dataset.value}` });
    if (specialEntries.length > 0) {
      sections.push({ title: 'Special Predictions', color: 'text-purple-400', entries: specialEntries });
    }

    // Count total picks
    let totalPicks = 0;
    sections.forEach(s => totalPicks += s.entries.length);

    // Update badge
    if (badge) {
      if (totalPicks > 0) {
        badge.textContent = String(totalPicks);
        badge.classList.add('has-picks');
      } else {
        badge.classList.remove('has-picks');
      }
    }

    // Update count in footer
    if (slipCount) {
      slipCount.textContent = `${totalPicks} pick${totalPicks !== 1 ? 's' : ''}`;
    }

    // Render the slip
    if (totalPicks === 0) {
      summary.innerHTML = '<p class="text-purple-400 text-sm text-center py-8">No predictions made yet.<br/>Select options above!</p>';
      return;
    }

    let html = '';
    sections.forEach(section => {
      html += `<div class="slip-section-header ${section.color}">${section.title}</div>`;
      section.entries.forEach(entry => {
        html += `<div class="slip-row">
          <span class="slip-label">${entry.label}</span>
          <span class="slip-value">${entry.value}</span>
        </div>`;
      });
    });

    summary.innerHTML = html;
  }

  // Listen for select changes
  document.querySelectorAll('.prediction-select').forEach(select => {
    select.addEventListener('change', () => {
      savePredictions();
      updatePredictionsSummary();
    });
  });

  // --- Betting Slip Drawer ---
  const slipToggle = document.getElementById('betting-slip-toggle');
  const slipDrawer = document.getElementById('betting-slip-drawer');
  const slipBackdrop = document.getElementById('slip-backdrop');
  const slipClose = document.getElementById('slip-close');

  function openSlip() {
    slipDrawer?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeSlip() {
    slipDrawer?.classList.remove('open');
    document.body.style.overflow = '';
  }

  slipToggle?.addEventListener('click', openSlip);
  slipBackdrop?.addEventListener('click', closeSlip);
  slipClose?.addEventListener('click', closeSlip);

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSlip();
  });

  // Load saved predictions when user changes
  $currentUser.subscribe(() => {
    setTimeout(loadPredictions, 100);
  });
  setTimeout(loadPredictions, 100);
</script>
